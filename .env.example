HOMEPAGE_VAR_DOCKER_HOST=docker-proxy.internal.example
HOMEPAGE_VAR_DOCKER_PORT=2375
HOMEPAGE_VAR_NPMPLUS_PUBLIC_URL=https://npmplus.example.com
HOMEPAGE_VAR_NPMPLUS_URL=http://npmplus.internal.example:81

