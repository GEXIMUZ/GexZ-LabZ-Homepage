HOMEPAGE_VAR_ADGUARD_PUBLIC_URL=https://adguard.example.com
HOMEPAGE_VAR_ADGUARD_URL=http://adguard.internal.example
HOMEPAGE_VAR_ADGUARD_USERNAME=YOUR_ADGUARD_USERNAME
HOMEPAGE_VAR_ADGUARD_PASSWORD=YOUR_ADGUARD_PASSWORD
HOMEPAGE_VAR_DOCKGE_PUBLIC_URL=https://dockge.example.com
