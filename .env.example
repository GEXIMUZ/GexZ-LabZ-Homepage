# Optional runtime tuning
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=9097
MEDIA_BIND=127.0.0.1
MEDIA_PORT=9098
TELEMETRY_BIND=127.0.0.1
TELEMETRY_PORT=9099
MEDIA_POLL_SECONDS=15
TELEMETRY_POLL_SECONDS=15
TELEMETRY_STALE_SECONDS=90
PING_TARGET=one.one.one.one
ALLOW_INSECURE_TLS=false
