# Copy this file outside the repository, restrict it to the service account,
# and replace every YOUR_* value. Never commit the real file.

# Homepage host allow-list
HOMEPAGE_ALLOWED_HOSTS=homepage.example.com

# Weather
HOMEPAGE_VAR_OPENWEATHERMAP_API_KEY=YOUR_OPENWEATHERMAP_API_KEY
HOMEPAGE_VAR_WEATHER_LATITUDE=YOUR_LATITUDE
HOMEPAGE_VAR_WEATHER_LONGITUDE=YOUR_LONGITUDE
WEATHER_LATITUDE=YOUR_LATITUDE
WEATHER_LONGITUDE=YOUR_LONGITUDE
WEATHER_LOCATION=Your location

# Core services
HOMEPAGE_VAR_HOME_ASSISTANT_PUBLIC_URL=https://home-assistant.example.com
HOMEPAGE_VAR_HOME_ASSISTANT_URL=http://home-assistant.internal.example:8123
HOMEPAGE_VAR_HOME_ASSISTANT_TOKEN=YOUR_HOME_ASSISTANT_TOKEN
HOMEPAGE_VAR_AUTHENTIK_PUBLIC_URL=https://authentik.example.com
HOMEPAGE_VAR_AUTHENTIK_URL=http://authentik.internal.example:9000
HOMEPAGE_VAR_AUTHENTIK_API_KEY=YOUR_AUTHENTIK_API_KEY
HOMEPAGE_VAR_PROXMOX_PUBLIC_URL=https://proxmox.example.com
HOMEPAGE_VAR_PROXMOX_URL=https://proxmox.internal.example:8006
HOMEPAGE_VAR_PROXMOX_NODE=YOUR_PROXMOX_NODE
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=YOUR_PROXMOX_TOKEN_ID
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=YOUR_PROXMOX_TOKEN_SECRET
HOMEPAGE_VAR_UPTIME_KUMA_PUBLIC_URL=https://uptime.example.com
HOMEPAGE_VAR_UPTIME_KUMA_URL=http://uptime.internal.example:3001
HOMEPAGE_VAR_UPTIME_KUMA_SLUG=YOUR_STATUS_PAGE_SLUG

# Network and infrastructure
HOMEPAGE_VAR_CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
